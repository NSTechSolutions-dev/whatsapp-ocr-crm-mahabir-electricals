generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum LearnedMappingSource {
  FINALIZE
  MANUAL_EDIT
  AUTO_CONFIRMED
}

enum EnquiryStatus {
  WAITING
  PROCESSING
  DRAFT
  REVIEW
  FINALIZED
  SENT
  IGNORED
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enquiries          Enquiry[]
  activityLogs       ActivityLog[]
  quotationTemplates QuotationTemplate[]
}

model Customer {
  id                 String   @id @default(cuid())
  phone              String   @unique
  name               String?
  company            String?
  stage              String   @default("Lead")
  hiddenFromPipeline Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversations Conversation[]
  enquiries     Enquiry[]
  scheduledJobs ScheduledJob[]
}

model Conversation {
  id               String   @id @default(cuid())
  customerId       String
  waConversationId String   @unique
  status           String   @default("open")
  lastMessageAt    DateTime @default(now())
  createdAt        DateTime @default(now())

  customer Customer           @relation(fields: [customerId], references: [id])
  messages WhatsappMessage[]
  enquiries Enquiry[]
}

model WhatsappMessage {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  type           String
  content        String?
  mediaUrl       String?
  waMessageId    String?
  createdAt      DateTime         @default(now())

  conversation  Conversation   @relation(fields: [conversationId], references: [id])
  enquiryImages EnquiryImage[]
}

model Enquiry {
  id             String        @id @default(cuid())
  conversationId String
  customerId     String
  status         EnquiryStatus @default(DRAFT)
  createdById    String
  sourceData     String?       @db.Text // Raw OCR text or source message
  gstPercent     Float         @default(18)
  gstMode        String        @default("exclusive")
  deliveryCharge Float         @default(0)
  billCustomerName    String?
  billCustomerPhone   String?
  billCustomerCompany String?
  finalizedAt       DateTime?
  processAt         DateTime?
  processingError   String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  conversation Conversation  @relation(fields: [conversationId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  items        EnquiryItem[]
  images       EnquiryImage[]
  quotation    Quotation?

  @@index([customerId, status, processAt])
}

model EnquiryImage {
  id         String   @id @default(cuid())
  enquiryId  String
  messageId  String   @unique
  imageUrl   String
  pageNumber Int
  uploadedAt DateTime @default(now())

  enquiry Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  message WhatsappMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
}

model EnquiryItem {
  id              String   @id @default(cuid())
  enquiryId       String
  inventoryId     String?
  autoInventoryId String?  @map("auto_inventory_id")
  rawText         String?
  productName     String
  qty             Float
  unit            String?
  rate            Float?
  confidence      Float    @default(1.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enquiry   Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  inventory Inventory? @relation(fields: [inventoryId], references: [id])
}

model Inventory {
  id                String   @id @default(cuid())
  name              String   @unique
  aliases           String[]
  searchText        String?  @map("search_text")
  currentRate       Float?
  unit              String?
  category          String?
  stock             Float    @default(0.0)
  lowStockThreshold Float    @default(10.0)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  items           EnquiryItem[]
  rateHistory     RateHistory[]
  unitRates       InventoryUnitRate[]
  embeddings      ProductEmbedding[]
  learnedMappings LearnedMapping[]
}

model InventoryUnitRate {
  id          String    @id @default(cuid())
  inventoryId String
  unit        String
  rate        Float
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, unit])
}

model ProductEmbedding {
  id           String   @id @default(cuid())
  inventoryId  String
  text         String
  model        String   @default("text-embedding-004")
  modelVersion String   @default("1") @map("model_version")
  createdAt    DateTime @default(now()) @map("created_at")
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, text])
  @@index([inventoryId])
}


model RateHistory {
  id          String   @id @default(cuid())
  inventoryId String
  rate        Float
  changedBy   String?
  recordedAt  DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("low_stock")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Quotation {
  id         String    @id @default(cuid())
  enquiryId  String    @unique
  s3Key      String
  s3Url      String
  tallyS3Key String?
  number     String    @unique
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id])
}

model QuotationTemplate {
  id             String   @id @default(cuid())
  name           String
  gstPercent     Float    @default(18)
  gstMode        String   @default("exclusive")
  deliveryCharge Float    @default(0)
  items          Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([createdAt])
}

model AutomationRule {
  id             String    @id @default(cuid())
  name           String
  triggerType    String    @unique
  triggerParams  Json
  actionType     String
  actionParams   Json
  isActive       Boolean   @default(true)
  lastExecutedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  scheduledJobs ScheduledJob[]
}

model ScheduledJob {
  id             String    @id @default(cuid())
  ruleId         String
  customerId     String
  scheduledAt    DateTime
  status         JobStatus @default(PENDING)
  bullJobId      String?
  messageId      String?
  messageContent String?   @db.Text
  errorMsg       String?
  metadata       Json?
  isTest         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  rule     AutomationRule @relation(fields: [ruleId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Sequence {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model CompanySetting {
  id             String   @id @default("default")
  companyName    String?
  companyAddress String?
  companyPhone   String?
  companyGstin   String?
  bankName       String?
  accountName    String?
  accountNumber  String?
  ifsc           String?
  branch         String?
  upiId          String?
  qrS3Key        String?
  updatedAt      DateTime @updatedAt
}

model BrandLogo {
  id        String   @id @default(cuid())
  name      String?
  s3Key     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model LearnedMapping {
  id            String               @id @default(cuid())
  lookupKey     String               @map("lookup_key")
  lookupKind    String               @map("lookup_kind")
  inventoryId   String               @map("inventory_id")
  hitCount      Int                  @default(1) @map("hit_count")
  source        LearnedMappingSource
  lastEnquiryId String?              @map("last_enquiry_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([lookupKey, lookupKind])
  @@index([inventoryId])
  @@index([lookupKey])
  @@map("LearnedMapping")
}
